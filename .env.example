# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; .env.example is committed with placeholders only.

# Django secret key -- signs sessions, CSRF tokens, and cookies. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# No local Python? Same thing via Docker:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-see-the-command-above

# Never leave this unset and never use DEMO_KEY -- settings raise on a missing
# key rather than falling back. Request a free key at https://api.nasa.gov/
NASA_API_KEY=your-nasa-api-key-here

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Consumed by the web service; docker-compose supplies a matching value.
DATABASE_URL=postgres://outside:outside@db:5432/outside

# Credentials for the postgres container itself (docker-compose only).
POSTGRES_DB=outside
POSTGRES_USER=outside
POSTGRES_PASSWORD=outside

# Optional tuning -- defaults shown.
# NASA_API_TIMEOUT=10.0
# WIKIPEDIA_API_TIMEOUT=5.0
# SUPPLEMENTAL_ENABLED=True
